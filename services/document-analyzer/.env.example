# Copy this file to `services/document-analyzer/.env` and fill in real values.
# Never commit the real file. The service refuses to start in production without a
# token of at least 32 bytes and a provider key.

ANALYZER_ENV=development
PORT=8000

# Shared secret the API server sends as `Authorization: Bearer <token>`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ANALYZER_TOKEN=replace-with-at-least-32-random-bytes

# DocuMind provider. Supported: openai, anthropic, azure, bedrock, gcp_vertex, gemini,
# ollama, vllm, custom.
DOCUMIND_LLM_PROVIDER=openai
DOCUMIND_LLM_MODEL=gpt-4o
DOCUMIND_LLM_API_KEY=replace-with-provider-key

# Optional: OpenAI-compatible endpoint, Azure endpoint or custom base URL.
DOCUMIND_LLM_BASE_URL=

# Additional provider settings, only when the provider needs them.
# DOCUMIND_AZURE_API_VERSION=2024-02-15-preview
# DOCUMIND_AWS_REGION=us-east-1
# DOCUMIND_AWS_SECRET_ACCESS_KEY=
# DOCUMIND_GCP_PROJECT_ID=
# DOCUMIND_GCP_LOCATION=us-central1
# DOCUMIND_GOOGLE_APPLICATION_CREDENTIALS=

# Limits. The default text cap is below the API's document cap so Node truncates first.
ANALYZER_MAX_CHARS=24000
ANALYZER_MAX_BYTES=2097152
ANALYZER_MAX_CONCURRENCY=2
ANALYZER_TIMEOUT_SECONDS=200
