# Copy this file to `services/document-analyzer/.env` and fill in real values.
# Load it with `uv run --env-file .env uvicorn app.main:app ...`; the service reads the
# process environment, it does not parse this file itself.
# Never commit the real file. The service refuses to start in production without a
# token of at least 32 bytes and a provider key.

ANALYZER_ENV=development
PORT=8000

# Shared secret the API server sends as `Authorization: Bearer <token>`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ANALYZER_TOKEN=replace-with-at-least-32-random-bytes

# No provider key lives here. Every plan runs on the account of the workspace that uploaded the
# document: the API sends that workspace's endpoint, model and key in the request's `llm` block,
# and this service hands it straight to the SDK. There are no DOCUMIND_LLM_* settings to set, and
# a request that carries no block is refused (422) rather than run on a key of this deployment's.

# Limits. This is the largest text one request may carry: the API splits a longer document into pages
# of this size and sends one request per page, merging the answers. It is not a per-document cap.
ANALYZER_MAX_CHARS=24000
ANALYZER_MAX_BYTES=2097152
ANALYZER_MAX_CONCURRENCY=2
ANALYZER_TIMEOUT_SECONDS=280
