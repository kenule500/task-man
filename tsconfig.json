{
  // Used by Vercel to compile the serverless entry (api/index.ts), which re-exports the Express app.
  // Mirrors services/api/tsconfig.json and includes the Express type augmentation (req.user, req.workspace…).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": ["./services/api/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "services/api/src/types/**/*.d.ts"],
  "exclude": ["node_modules", "client", "services/api/dist"]
}
