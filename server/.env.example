# Copy this file to `server/.env` and fill in real values.
# Never commit `server/.env` — it contains secrets.

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local example:
MONGO_URI=mongodb://127.0.0.1:27017/task-man
# Atlas example:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/task-man?retryWrites=true&w=majority

# JWT
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Secret box: key that encrypts authenticator secrets and workspace AI keys in the database (AES-256-GCM, derived with HKDF).
# At least 32 random characters. Leave empty to derive it from JWT_SECRET. Set it before people enroll or save an AI key
# and keep it stable: changing it makes existing authenticator secrets and AI keys unreadable (the UI asks to replace them).
TWO_FACTOR_KEY=

# Personal API tokens are stored as PBKDF2 digests keyed with this secret (falls back to JWT_SECRET).
# Changing it revokes every API token.
API_TOKEN_PEPPER=

# Frontend URL — used to build verification, reset, and invitation links
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
# Max requests per 15 minutes per IP for the app API (auth routes are stricter)
RATE_LIMIT_MAX=500
# Number of reverse proxies in front of the API in production
# (1 on Render, 0 on localhost)
TRUST_PROXY=0

# Email via Resend HTTP API (preferred, works on serverless): https://resend.com -> API Keys.
# Takes precedence over SMTP. Without a verified domain Resend only delivers to the
# Resend account owner's address; verify a domain and set EMAIL_FROM to send to anyone.
RESEND_API_KEY=

# Email (SMTP)
# In development, set DEV_AUTO_VERIFY=true to skip email verification entirely.
# When DEV_AUTO_VERIFY=false, these SMTP settings are used.
# Leave EMAIL_HOST empty to print emails (with links) to the server console.

# Mailtrap sandbox example:
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-mailtrap-username
EMAIL_PASS=your-mailtrap-password
EMAIL_FROM="TaskMan <noreply@taskman.dev>"

# Production SMTP example (Resend / SendGrid / Postmark):
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USER=resend
# EMAIL_PASS=your-resend-api-key
# EMAIL_FROM="TaskMan <noreply@yourdomain.com>"

# Dev-mode: auto-verify users on signup (no email required for testing)
# Set to false in production.
DEV_AUTO_VERIFY=true

# Web Push (device notifications). Leave empty to turn push off; nothing else changes.
# Generate a key pair once with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is shared with browsers; keep VAPID_PRIVATE_KEY secret and never commit it.
# Changing the pair later invalidates every subscribed device (people turn push on again).
# VAPID_SUBJECT is a contact for the push services: mailto:you@example.com or your https site URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Single sign-on (OpenID Connect, authorization code + PKCE). Each provider is off until BOTH its id and secret are set.
# Callback URL to register at the provider: <API base>/auth/sso/<provider>/callback
#   production (API and app share one origin): https://your-host/api/auth/sso/google/callback  (and .../microsoft/callback)
#   local development: http://localhost:5000/api/auth/sso/google/callback
# API_PUBLIC_URL is only needed when the API is NOT served at <CLIENT_URL>/api (for example http://localhost:5000/api in development).
API_PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (any work, school or personal account), organizations (work or school only), consumers (personal only),
# or a tenant id / verified domain to allow one organization only
MICROSOFT_TENANT=common

# AI limits (AI code review and "Create with AI" projects).
# Provider credentials are workspace-level BYOK: each workspace saves its provider, endpoint, model and
# encrypted API key under Settings > Workspace > AI code review. No AI_* or DASHSCOPE_* provider key,
# endpoint or model is read from the environment, and nothing from a server key is copied into a workspace.
# The secrets are encrypted with TWO_FACTOR_KEY (or JWT_SECRET when it is empty); keep that value stable.
# Reviews a workspace may start per UTC day
AI_REVIEW_DAILY_LIMIT=50
# Characters of diff sent to the model per review (default 120000). Lower it for models with a small context window.
# AI_REVIEW_MAX_DIFF_CHARS=120000

# AI project from a document (Projects > Create with AI). Uses each workspace's own provider, key, endpoint and opt-in;
# the text of the uploaded document is sent to the provider. All optional:
# Plans a workspace may start per UTC day (separate from the review limit)
# AI_PLAN_DAILY_LIMIT=20
# Characters of the document sent to the model; a longer one keeps its beginning and section headings (the plan is marked partial)
# AI_PLAN_MAX_CHARS=60000
# Largest upload in MB. Vercel refuses request bodies above 4.5 MB, so keep it at 4 or below there.
# AI_PLAN_MAX_MB=4
# Size of the model's answer in tokens (raise it for models that allow more) and the time one request may take
# AI_PLAN_MAX_OUTPUT_TOKENS=8192
# AI_PLAN_TIMEOUT_SECONDS=200
