# Copy to server/.env and fill in. Never commit server/.env.
NODE_ENV=development
PORT=5000

# MongoDB (local example; use your own Atlas URI in production)
MONGO_URI=mongodb://127.0.0.1:27017/task-man

# At least 32 random characters, e.g. `openssl rand -hex 32`. Required.
JWT_SECRET=replace-with-a-long-random-secret

# Public URL of the web app (email links) and allowed CORS origins (comma separated)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Requests per 15 minutes per IP for the app API (auth routes stay at 100)
RATE_LIMIT_MAX=500
# Number of reverse proxies in front of the API in production (e.g. 1 on Render)
TRUST_PROXY=0

# SMTP. Leave EMAIL_HOST empty in development to print emails (with links) to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="TaskMan <noreply@example.com>"
